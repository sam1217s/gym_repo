# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores. `.env` NUNCA se versiona.
# `src/config/entorno.js` valida estas variables con Zod al arrancar: si falta
# alguna o tiene un valor invalido, el proceso muere antes de escuchar peticiones.
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto del servidor Express
PUERTO=3000

# URI de conexion a MongoDB Atlas (incluye el nombre de la base de datos)
MONGO_URI=mongodb+srv://usuario:contrasena@cluster.mongodb.net/gymsaas?retryWrites=true&w=majority

# Secretos JWT. DEBEN ser distintos entre si y tener minimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO_ACCESO=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres-o-mas
JWT_SECRETO_REFRESCO=cambia-esto-por-otro-secreto-distinto-igual-de-largo-y-aleatorio

# Origen del frontend. Solo se usa para CORS en produccion:
# en desarrollo el proxy de Quasar hace que todo sea same-origin.
ORIGEN_FRONTEND=http://localhost:9000

# Credenciales del super_admin que crea `npm run sembrar`
SEMILLA_SUPERADMIN_EMAIL=admin@gymsaas.co
SEMILLA_SUPERADMIN_CONTRASENA=CambiaEstaClave123

# Cron diario de avisos de vencimiento por WhatsApp (9:00, America/Bogota).
# Ponlo en `false` en TODAS las instancias menos una: si dos procesos de la API
# lo programan, cada miembro recibe el aviso dos veces.
# El proveedor de WhatsApp NO se configura aqui: vive en cada gimnasio, dentro
# de `tenant.config.whatsapp`, porque dos gimnasios pueden usar canales distintos.
HABILITAR_CRON=true
