# ---------------------------------------------------------------------------
# Agente de la puerta: SOLO DESARROLLO. Copia este archivo a `.env` en esta carpeta.
# En un PC de puerta real no hay .env: se usa el instalador (instalador/construir.ps1),
# cuyos valores por defecto son los de produccion, y el equipo se VINCULA desde la
# ventana /acceso (el token queda en ProgramData\GymBarichara\Puerta\config.json).
# ---------------------------------------------------------------------------

# API de GymBarichara (con /api al final).
#   Local:      http://localhost:3000/api
#   Produccion: https://gymbarichara.com/api
SERVIDOR_API=http://localhost:3000/api

# Opcional: token de un puesto, para no vincular desde la ventana. Si config.json ya
# tiene uno (por haber vinculado), ese gana. Sin token, el agente solo sirve para
# REGISTRAR huellas (recepcion), no para controlar la puerta.
TOKEN_PUESTO=

# Puerto del WebSocket local al que se conectan las pantallas (solo 127.0.0.1).
PUERTO_LOCAL=7788

# Paginas que pueden conectarse al agente (separadas por coma).
ORIGENES_PERMITIDOS=http://localhost:9000,https://gymbarichara.com

# Cada cuanto se bajan las huellas del servidor (miembros nuevos, bajas).
SEGUNDOS_SINCRONIZACION=60
